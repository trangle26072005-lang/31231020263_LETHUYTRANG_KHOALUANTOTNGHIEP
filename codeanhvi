def _is_bad_ocr_text(text: str, threshold: float = 0.20) -> bool:
    """
    Phát hiện OCR có dấu hiệu bất thường.

    Không dùng whitelist ký tự và không blacklist token cụ thể.
    Chỉ dựa trên:
    - Unicode replacement character
    - Control character
    - Tỷ lệ symbol bất thường
    - Tỷ lệ token quá ngắn / có cấu trúc bất thường
    """

    if not text or not text.strip():
        return True

    text = unicodedata.normalize("NFC", text)

    # 1. Replacement character: dấu hiệu lỗi rất rõ
    if "\ufffd" in text:
        return True

    chars = [ch for ch in text if not ch.isspace()]

    if not chars:
        return True

    # 2. Control character bất thường
    control_count = sum(
        1
        for ch in chars
        if unicodedata.category(ch).startswith("C")
    )

    control_ratio = control_count / len(chars)

    if control_ratio > 0.01:
        return True

    # 3. Phân tích token
    tokens = text.split()

    if not tokens:
        return True

    suspicious_tokens = 0

    for token in tokens:
        token = token.strip()

        if not token:
            continue

        # Token chỉ có 1 ký tự: chỉ đánh dấu nhẹ,
        # không coi đó là lỗi tuyệt đối.
        if len(token) == 1:
            suspicious_tokens += 0.25

        alpha_num = sum(
            1 for ch in token
            if ch.isalnum()
        )

        symbols = sum(
            1 for ch in token
            if not ch.isalnum()
        )

        # Quá nhiều symbol so với chữ/số
        if len(token) >= 3 and symbols > alpha_num * 2:
            suspicious_tokens += 1

        # Nhiều symbol liên tiếp
        if re.search(r"[^\w\s]{3,}", token, re.UNICODE):
            suspicious_tokens += 1

    token_ratio = suspicious_tokens / len(tokens)

    # Kết hợp 2 loại tín hiệu
    score = (
        control_ratio * 0.7
        + token_ratio * 0.3
    )

    return score >= threshold


def extract_text_from_pdf(pdf_path: str, dpi: int = 300, max_workers: int = 4) -> dict:
    """
    Trích xuất toàn bộ text từ 1 file PDF.

    - Trang có text quá ít -> OCR.
    - OCR có dấu hiệu bất thường -> OCR lại với PSM khác.
    """
    parts = []
    try:
        doc = fitz.open(pdf_path)

        zoom = dpi / 72
        matrix = fitz.Matrix(zoom, zoom)

        n_pages = len(doc)
        results = [""] * n_pages
        ocr_jobs = []
        # ==================================================
        # 1. Đọc text bằng PyMuPDF
        # ==================================================
        for i, page in enumerate(doc):
            blocks = page.get_text("blocks")

            seen_block_text = set()
            unique_texts = []

            for b in blocks:
                text = b[4].strip()

                if text and text not in seen_block_text:
                    seen_block_text.add(text)
                    unique_texts.append(text)

            page_text = "\n\n".join(unique_texts)   # trước đây là "\n".join(...)

            # Text quá ít -> coi như trang scan -> OCR
            if len(page_text.strip()) < 50:
                pix = page.get_pixmap(
                    matrix=matrix,
                    alpha=False
                )

                img = Image.frombytes(
                    "RGB",
                    (pix.width, pix.height),
                    pix.samples
                )

                ocr_jobs.append((i, img))

            else:
                results[i] = page_text

        doc.close()
        # ==================================================
        # 2. OCR
        # ==================================================
        def run_ocr(job):
            i, img = job
            try:
                # OCR lần 1
                raw_text = pytesseract.image_to_string(
                    img,
                    lang="vie",
                    config="--oem 3 --psm 6"
                )

                # Nếu OCR có dấu hiệu bất thường,
                # thử OCR lại với PSM 3.
                if _is_bad_ocr_text(raw_text):
                    retry_text = pytesseract.image_to_string(
                        img,
                        lang="vie",
                        config="--oem 3 --psm 3"
                    )

                    # Chỉ dùng kết quả retry nếu nó
                    # không còn bị đánh giá là lỗi.
                    if not _is_bad_ocr_text(retry_text):
                        raw_text = retry_text

                    else:
                        print(
                            f"\n   [OCR CẢNH BÁO] "
                            f"Trang {i + 1}: "
                            f"Kết quả OCR vẫn có dấu hiệu bất thường."
                        )

                # Chuẩn hóa Unicode + whitespace
                text = unicodedata.normalize(
                    "NFC",
                    raw_text
                )

                text = re.sub(
                    r"[\r\n\t]+",
                    " ",
                    text
                )

                text = re.sub(
                    r"\s+",
                    " ",
                    text
                )

                return i, text.strip()

            except Exception as ocr_err:
                print(
                    f"\n   [OCR LỖI] "
                    f"Trang {i + 1}: {ocr_err}"
                )

                return i, ""

        # ==================================================
        # 3. Chạy OCR song song
        # ==================================================

        if ocr_jobs:
            with ThreadPoolExecutor(
                max_workers=max_workers
            ) as executor:

                for i, text in executor.map(
                    run_ocr,
                    ocr_jobs
                ):
                    results[i] = text

        parts = results

    except Exception as e:
        print(
            f"\n  [LỖI] Không đọc được "
            f"{pdf_path}: {e}"
        )

    return {
    "text": "\n\n".join(parts)   # trước đây là "\n".join(parts)
    }
 
 
def normalize_text(text: str) -> str:
    """
    Chuẩn hóa văn bản dùng cho thống kê.

    - Chuẩn hóa Unicode tiếng Việt
    - lowercase
    - Xuống dòng/tab -> khoảng trắng
    - Gộp khoảng trắng thừa
    - Không tự thêm dấu câu
    """

    if not text:
        return ""
    text = unicodedata.normalize("NFC", text)
    text = text.lower()
    text = re.sub(r"[\r\n\t]+", ".", text)
    text = re.sub(r"\s+", " ", text)

    return text.strip()
 
def normalize_text_for_keywords(text: str) -> str:
    if not text:
        return ""
    text = unicodedata.normalize("NFC", text)
    text = re.sub(r"[•●○◦▪▫◾◽■□◆◇▶▷►▻]", " ", text)
    text = re.sub(r"(?m)^\s*[-–—]\s*", " ", text)

    # Ranh giới block (nhiều dòng trống) -> coi như hết câu, chặn keyword ghép xuyên block
    text = re.sub(r"\n{2,}", ". ", text)

    # Xuống dòng đơn / tab trong cùng 1 đoạn -> khoảng trắng bình thường
    text = re.sub(r"[\r\n\t]+", " ", text)
    text = re.sub(r"\s+", " ", text)

    return text.strip()


def _compile_pattern(term: str, case_sensitive: bool):
    flags = re.UNICODE
    if not case_sensitive:
        flags |= re.IGNORECASE
    return re.compile(
        rf"(?<!\w)(?<!\d\.){re.escape(term)}(?!\w)",   # <-- thêm (?<!\d\.)
        flags
    )


def _is_negative_context(text: str, pos: int) -> bool:
    before = text[max(0, pos - NEGATIVE_CONTEXT_WINDOW):pos].lower()
    return any(neg in before for neg in NEGATIVE_CONTEXT_WORDS)
def _is_document_number_context(
    text: str,
    end_pos: int,
    window: int = 30
) -> bool:
    """
    Kiểm tra keyword có đang nằm trong context của số hiệu
    dạng 01/2024, 01.2024, 01-2024...
    """

    after = text[end_pos:end_pos + window]

    return bool(
        re.search(
            r"^[\s.|]{0,10}\d+[./-]\d",
            after
        )
    )
_FINANCIAL_STATEMENT_MARKERS = [
    "bảng cân đối kế toán", "cân đối kế toán", "thuyết minh",
    "báo cáo tài chính", "mã số", "số cuối năm", "số đầu năm",
]

def _is_financial_statement_header(text: str, pos: int, window: int = 100) -> bool:
    around = text[max(0, pos - window):pos + window].lower()
    return any(marker in around for marker in _FINANCIAL_STATEMENT_MARKERS)
_VALID_VN_CHARS = set(
    "abcdefghijklmnopqrstuvwxyz"
    "àáảãạăằắẳẵặâầấẩẫậbcdđeèéẻẽẹêềếểễệfghiìíỉĩị"
    "klmnoòóỏõọôồốổỗộơờớởỡợpqrstuùúủũụưừứửữựvwxyýỳỷỹỵz"
    "0123456789 .,;:!?()%-/"
)

def _garbled_score(text: str, start: int, end: int, window: int = 40) -> float:
    seg = text[max(0, start - window):end + window].strip()
    tokens = seg.split()
    if not tokens:
        return 1.0
    bad = 0
    keep_short = {"x", "o", "a", "e", "i", "u", "y"}  # ký tự đơn lẻ hợp lệ (bảng checkbox, số đếm...)
    for tok in tokens:
        core = tok.strip(".,;:!?()|-").lower()
        if not core:
            continue
        if len(core) == 1 and not core.isdigit() and core not in keep_short:
            bad += 1
            continue
        odd = sum(1 for ch in core if ch not in _VALID_VN_CHARS)
        if odd / len(core) > 0.3:
            bad += 1
    return bad / len(tokens)

def _is_garbled_context(text: str, start: int, end: int, window: int = 40, threshold: float = 0.35) -> bool:
    return _garbled_score(text, start, end, window) > threshold

def count_and_find_occurrences(
    text: str,
    keyword_terms: dict,
    window: int = CONTEXT_WINDOW
):
    occurrences = []
    for keyword, term_infos in keyword_terms.items():
        seen_spans = set()
        for term, case_sensitive in term_infos:
            pattern = _compile_pattern(
                term,
                case_sensitive
            )
            for m in pattern.finditer(text):
                # ----------------------------------------------
                # 1. Chống duplicate cùng span
                # ----------------------------------------------
                if m.span() in seen_spans:
                    continue
                # ----------------------------------------------
                # 2. Negative context
                # ----------------------------------------------
                if _is_negative_context(
                    text,
                    m.start()
                ):
                    continue
                # ----------------------------------------------
                # 3. Document number context
                # ----------------------------------------------
                if _is_document_number_context(
                    text,
                    m.end()
                ):
                    continue
                # ----------------------------------------------
                # 4. Garbled context
                # ----------------------------------------------
                if (
                    case_sensitive
                    and _is_garbled_context(
                        text,
                        m.start(),
                        m.end()
                    )
                ):
                    continue
                # ----------------------------------------------
                # 5. Financial statement header
                # ----------------------------------------------
                if (
                    keyword == "Tài sản số"
                    and _is_financial_statement_header(
                        text,
                        m.start()
                    )
                ):
                    continue
                seen_spans.add(m.span())
                # ----------------------------------------------
                # 6. Context
                # ----------------------------------------------
                start = max(
                    0,
                    m.start() - window
                )
                end = min(
                    len(text),
                    m.end() + window
                )
                context = (
                    text[start:end]
                    .replace("\n", " ")
                    .strip()
                )
                occurrences.append({
                    "keyword": keyword,
                    "matched_term": term,
                    "context": f"…{context}…"
                })
    counts = collections.Counter(
        o["keyword"]
        for o in occurrences
    )

    return counts, occurrences
 
 
