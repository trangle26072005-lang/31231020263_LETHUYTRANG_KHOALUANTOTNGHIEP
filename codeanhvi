def sanitize_for_excel(value):
    """Loại bỏ ký tự điều khiển mà Excel không cho phép ghi vào cell."""
    if isinstance(value, str):
        return ILLEGAL_CHARACTERS_RE.sub("", value)
    return value

def sanitize_dataframe(df: pd.DataFrame) -> pd.DataFrame:
    if df.empty:
        return df
    return df.map(sanitize_for_excel)  # pandas >= 2.1; dùng .applymap nếu bản cũ hơn
def write_excel_output(detail_rows, summary_rows, occurrence_rows, output_file=OUTPUT_FILE):
    """
    Ghi 3 danh sách kết quả ra file Excel, sau khi đã sanitize.
    Tách thành hàm riêng để có thể gọi lại độc lập từ checkpoint
    nếu bước ghi Excel trong main() bị lỗi giữa chừng.
    """
    df_detail = sanitize_dataframe(pd.DataFrame(detail_rows))
    df_summary = sanitize_dataframe(pd.DataFrame(summary_rows))
    df_occurrence = sanitize_dataframe(pd.DataFrame(occurrence_rows))
 
    with pd.ExcelWriter(output_file, engine="openpyxl") as writer:
        df_summary.to_excel(writer, sheet_name="Bank_Year_Summary", index=False)
        df_detail.to_excel(writer, sheet_name="Keyword_Counts", index=False)
        df_occurrence.to_excel(writer, sheet_name="Keyword_Occurrences", index=False)
 
def rebuild_excel_from_checkpoint(checkpoint_path=CHECKPOINT_FILE, output_file=OUTPUT_FILE):
    """
    Khôi phục và ghi lại Excel từ file checkpoint đã lưu,
    KHÔNG cần chạy lại OCR/trích xuất PDF.
 
    Dùng khi: main() đã chạy xong vòng lặp xử lý PDF (đã lưu checkpoint),
    nhưng bước ghi Excel bị lỗi (ví dụ IllegalCharacterError, mất điện,
    đầy ổ đĩa...).
 
    Cách dùng: mở terminal, chạy:
        python -c "from codeanhvi import rebuild_excel_from_checkpoint; rebuild_excel_from_checkpoint()"
    """
    if not os.path.isfile(checkpoint_path):
        print(f"[LỖI] Không tìm thấy checkpoint tại '{checkpoint_path}'.")
        return
 
    with open(checkpoint_path, "rb") as f:
        data = pickle.load(f)
 
    write_excel_output(
        data["detail_rows"],
        data["summary_rows"],
        data["occurrence_rows"],
        output_file=output_file,
    )
    print(f"✅ Đã ghi lại Excel từ checkpoint: {output_file}")

def load_keyword_dictionary(path: str, sheet_name: str = "Keywords_Used"):
    """
    Đọc keyword_dictionary.xlsx, trả về:
      - groups: {dimension: [keyword, ...]}          -> dùng cho detail_rows như code cũ
      - terms_map: {keyword: [(term, case_sensitive), ...]}  -> keyword chính + alias, để đếm
    """
    wb = openpyxl.load_workbook(path, data_only=True)
    ws = wb[sheet_name]
    header = [c.value for c in next(ws.iter_rows(min_row=1, max_row=1))]
    col = {name: i for i, name in enumerate(header)}

    groups, terms_map, id_map, dimension_map = {}, {}, {}, {}
    for row in ws.iter_rows(min_row=2, values_only=True):
        if not row or row[col["Keyword ID"]] is None:
            continue
        keyword = unicodedata.normalize("NFC", str(row[col["Keyword"]]).strip())
        dimension = row[col["Keyword Dimension"]]
        kid = row[col["Keyword ID"]]
        aliases_raw = row[col["Aliases"]]
        aliases = (
            [unicodedata.normalize("NFC", a.strip()) for a in aliases_raw.split(";") if a.strip()]
            if aliases_raw else []
        )

        groups.setdefault(dimension, []).append(keyword)
        all_terms = [keyword] + aliases
        terms_map[keyword] = [(t, len(t) <= SHORT_TERM_MAX_LEN) for t in all_terms]
        id_map[keyword] = kid
        dimension_map[keyword] = dimension
        

    return groups, terms_map, id_map, dimension_map
        
