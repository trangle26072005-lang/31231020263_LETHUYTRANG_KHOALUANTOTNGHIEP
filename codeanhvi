def parse_filename(filename: str):
    """
    Tách Mã CK và Năm từ tên file, giả định định dạng: MACK_NAM.pdf
    VD: FPT_2020.pdf -> ("FPT", 2020)
    Nếu tên file không đúng định dạng, trả về (tên file, None) và bạn
    cần bổ sung thủ công trong file Excel kết quả.
    """
    base = os.path.splitext(os.path.basename(filename))[0]
    match = re.match(r"([A-Za-z0-9]+)[_\-](\d{4})", base)
    if match:
        return match.group(1).upper(), int(match.group(2))
    return base, None
 

_progress_initialized = False
_start_time = None

def show_overall_progress(current: int, total: int, current_filename: str = "", status: str = ""):
    global _progress_initialized, _start_time

    if _start_time is None:
        _start_time = time.time()

    elapsed = time.time() - _start_time
    percent = (current / total) * 100 if total > 0 else 100
    bar_len = 30
    filled = int(bar_len * current / total) if total > 0 else bar_len
    bar = "▰" * filled + "▱" * (bar_len - filled)

    # Tính ETA dựa trên tốc độ trung bình/file đã xử lý xong
    if current > 0:
        avg_time_per_file = elapsed / current
        remaining = avg_time_per_file * (total - current)
    else:
        remaining = 0

    def fmt_time(seconds: float) -> str:
        seconds = int(seconds)
        h, rem = divmod(seconds, 3600)
        m, s = divmod(rem, 60)
        if h > 0:
            return f"{h}h{m:02d}p{s:02d}s"
        return f"{m}p{s:02d}s"

    line1 = (f"[{bar}] {percent:5.1f}% ({current}/{total} file) "
              f"| Đã chạy: {fmt_time(elapsed)} | Còn lại: ~{fmt_time(remaining)}")
    line2 = f"   -> {status}: {current_filename}"

    if _progress_initialized:
        sys.stdout.write("\x1b[2A")
    _progress_initialized = True

    sys.stdout.write("\x1b[2K" + line1 + "\n")
    sys.stdout.write("\x1b[2K" + line2 + "\n")
    sys.stdout.flush()

def main():
    global _progress_initialized, _start_time
    _progress_initialized = False
    _start_time = None  # reset lại mỗi lần chạy main()

    if not os.path.isdir(INPUT_FOLDER):
        print(f"[LỖI] Không tìm thấy thư mục '{INPUT_FOLDER}'.")
        return

    pdf_files = glob.glob(os.path.join(INPUT_FOLDER, "*.pdf"))
    if not pdf_files:
        print(f"[LỖI] Không có file .pdf nào trong thư mục '{INPUT_FOLDER}'.")
        return

    total_files = len(pdf_files)
    print(f"Tìm thấy {total_files} file PDF. Bắt đầu xử lý...\n")

    detail_rows = []
    summary_rows = []
    occurrence_rows = []

    for idx, pdf_path in enumerate(sorted(pdf_files), 1):
        filename = os.path.basename(pdf_path)
        ma_ck, nam = parse_filename(filename)

        show_overall_progress(idx - 1, total_files, filename, status="Đang xử lý")

        extraction = extract_text_from_pdf(pdf_path)
        raw_text = extraction["text"]

        norm_text = normalize_text(raw_text)
        total_words = count_total_words(norm_text)
        kw_text = normalize_text_for_keywords(raw_text)
        kw_counts, occurrences = count_and_find_occurrences(kw_text, KEYWORD_TERMS)
        total_kw_count = sum(kw_counts.values()) 

        for group_name, kws in KEYWORD_GROUPS.items():
            for kw in kws:
                if kw_counts.get(kw, 0) > 0:
                   detail_rows.append({
                    "Ma_CK": ma_ck, "Nam": nam, "File": filename,
                    "Nhom_tu_khoa": group_name, "Tu_khoa": kw,
                    "So_lan_xuat_hien": kw_counts[kw],
                })
        for occ in occurrences:
            occurrence_rows.append({
                "Ma_CK": ma_ck, "Nam": nam, "File": filename,
                "Keyword_ID": KEYWORD_ID_MAP[occ["keyword"]], "Tu_khoa": occ["keyword"],
                "Alias_khop": occ["matched_term"],
                "Nhom_tu_khoa": KEYWORD_DIMENSION_MAP[occ["keyword"]],
                "Ngu_canh": occ["context"],
            })

        digi_ln = math.log(total_kw_count + 1)
        digi_ratio = (total_kw_count / total_words) if total_words > 0 else 0
        digi_binary = 1 if total_kw_count > 0 else 0

        summary_rows.append({
            "Ma_CK": ma_ck, "Nam": nam, "File": filename,
            "Tong_so_tu_trong_BCTN": total_words,
            "Tong_tan_suat_tu_khoa": total_kw_count,
            "DIGI_ln": round(digi_ln, 4),
            "DIGI_ty_le(%)": round(digi_ratio * 100, 4),
            "DIGI_nhi_phan": digi_binary,
        })

        show_overall_progress(idx, total_files, filename, status="Đã xong")

    # Checkpoint: lưu kết quả thô ra đĩa trước khi ghi Excel
    with open("checkpoint_results.pkl", "wb") as f:
        pickle.dump({
            "detail_rows": detail_rows,
            "summary_rows": summary_rows,
            "occurrence_rows": occurrence_rows,
        }, f)
    print("💾 Đã lưu checkpoint tạm tại checkpoint_results.pkl")
    total_elapsed = time.time() - _start_time
    print(f"\nTổng thời gian xử lý: {total_elapsed/60:.1f} phút\n")
    avg_per_file = total_elapsed / total_files if total_files > 0 else 0
    def fmt_time(seconds: float) -> str:
        seconds = int(seconds)
        h, rem = divmod(seconds, 3600)
        m, s = divmod(rem, 60)
        if h > 0:
            return f"{h} giờ {m:02d} phút {s:02d} giây"
        return f"{m} phút {s:02d} giây"
    

    df_detail = sanitize_dataframe(pd.DataFrame(detail_rows))
    df_summary = sanitize_dataframe(pd.DataFrame(summary_rows))
    df_occurrence = sanitize_dataframe(pd.DataFrame(occurrence_rows))

    with pd.ExcelWriter(OUTPUT_FILE, engine="openpyxl") as writer:
        df_summary.to_excel(writer, sheet_name="Bank_Year_Summary", index=False)
        df_detail.to_excel(writer, sheet_name="Keyword_Counts", index=False)
        df_occurrence.to_excel(writer, sheet_name="Keyword_Occurrences", index=False)

    print(f"✅ HOÀN TẤT! Kết quả đã lưu tại: {OUTPUT_FILE}")
    print(f"   - Sheet 'Tong_hop': dùng để đưa vào Stata/R/Python chạy hồi quy")
    print(f"   - Sheet 'Chi_tiet': dùng để kiểm tra lại từng từ khóa nếu cần")
    print(f"⏱  Tổng thời gian chạy: {fmt_time(total_elapsed)}  ({total_files} file, "
          f"trung bình {avg_per_file:.1f}s/file)")
 
if __name__ == "__main__":
    main()
